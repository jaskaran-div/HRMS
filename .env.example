# Copy this file to .env.local and fill it in. Never put real keys in THIS file.

# Supabase project URL, like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Logins are username + password; Supabase Auth needs an email, so each username maps to
# username@<this domain>. No email is ever sent. Use a domain you own.
NEXT_PUBLIC_LOGIN_DOMAIN=derivion.in

# Random string; Vercel Cron sends it so only Vercel can call /api/cron/purge
CRON_SECRET=

# Outgoing email (payslip emails). Sent from the address set in Customisations > Sender Email Preferences (default hr@derivion.in),
# which must be allowed for this SMTP account. SERVER ONLY - never prefix with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave blank for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
