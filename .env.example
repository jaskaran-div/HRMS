# Copy this file to .env.local and fill it in. Never put real keys in THIS file.

# Supabase project URL, like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Logins are username + password; Supabase Auth needs an email, so each username maps to
# username@<this domain>. No email is ever sent. Use a domain you own.
NEXT_PUBLIC_LOGIN_DOMAIN=derivion.in

# Random string; Vercel Cron sends it so only Vercel can call /api/cron/purge
CRON_SECRET=

# Outgoing email (payslip emails). Sent from the address set in Customisations > Sender Email Preferences (default hr@derivion.in),
# which must be allowed for this SMTP account. SERVER ONLY - never prefix with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave blank for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Mail only goes to official company addresses. Comma separated domains; blank = the sender address's domain.
COMPANY_EMAIL_DOMAINS=derivion.in
# Public address of the portal, used for links in emails (login details, leave). Optional: defaults to the address it is opened on.
APP_URL=https://hr.derivion.in

# Document storage in Google Drive (HR uploads company docs and employee docs). SERVER ONLY.
# Folder id = the last part of the folder's URL: https://drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_FOLDER_ID=
# Option A (Google Workspace, recommended): a service account. The folder must be inside a Shared drive
# where the service account's email is a member with "Content manager" access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account's JSON key, in quotes, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=
# Option B (a normal Google account's Drive): OAuth client + refresh token with the drive scope. Used instead of A when all 3 are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------------------------
# SaaS: organizations, registration, billing. Run supabase/saas.sql once (after schema.sql).
# ---------------------------------------------------------------------------------------------
# Platform name in emails / the login page, and the address platform emails come from (registration,
# invitations, payment problems). Must be allowed for the SMTP account above. SERVER ONLY.
PLATFORM_NAME=
PLATFORM_SENDER_EMAIL=
# Contact Sales requests are emailed here
SALES_EMAIL=
# Login page name + logo: this organization (its slug). Blank = derivion (the first organization); "none" = PLATFORM_NAME
LOGIN_BRAND_ORG=

# Stripe — the ONLY payment provider. SERVER ONLY: never prefix any of these with NEXT_PUBLIC_ / EXPO_PUBLIC_,
# never put them in the mobile app. Use TEST keys (sk_test_ / pk_test_) on staging and LIVE keys only on production;
# never mix them. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → endpoint https://<your domain>/api/stripe/webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Recurring price of the base subscription (price_…)
STRIPE_BASE_PRICE_ID=
# Optional add-ons: recurring price ids (price_…). Leave blank to not offer that add-on.
STRIPE_ADDON_PAYROLL_PRICE_ID=
STRIPE_ADDON_DOCUMENTS_PRICE_ID=
STRIPE_ADDON_EMAIL_PRICE_ID=
# Optional safety check: "test" or "live". Must match the keys. A production server (NODE_ENV=production)
# refuses test keys unless this is set to "test".
STRIPE_MODE=

# Organizations can connect their own mailbox (Customisations → Your mail server) so their emails come from their
# own address. Their mail passwords are encrypted with this key. Any random string of 32+ characters, e.g.
# `openssl rand -base64 48`. SERVER ONLY. Keep it safe: if it changes, organizations must re-enter their mail password.
MAIL_SECRET_KEY=
